 def _tokens(text):
-    raise NotImplementedError
+    """Split ``text`` into a list of tokens.
+
+    A token is either ``("num", int)`` for an integer literal or a plain
+    string for an operator / parenthesis.  Only spaces may separate tokens.
+    """
+    tokens = []
+    i = 0
+    n = len(text)
+    while i < n:
+        ch = text[i]
+        if ch == " ":
+            i += 1
+            continue
+        if ch in _DIGITS:
+            j = i
+            while j < n and text[j] in _DIGITS:
+                j += 1
+            tokens.append(("num", int(text[i:j])))
+            i = j
+            continue
+        pair = text[i:i + 2]
+        if pair in _TWO_CHAR:
+            tokens.append(pair)
+            i += 2
+            continue
+        if ch in _ONE_CHAR:
+            tokens.append(ch)
+            i += 1
+            continue
+        raise ValueError("unknown character: %r" % (ch,))
+    if not tokens:
+        raise ValueError("empty expression")
+    return tokens
+
 
 class _Parser:
