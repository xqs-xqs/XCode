+    unary      := "-" unary | power
+    power      := atom ["**" unary]
+    atom       := number | "(" expression ")"
+
+    ``power`` takes its exponent through ``unary``, which makes ``**``
+    right-associative and lets an exponent start with a unary minus, while
+    ``unary`` delegating to ``power`` keeps ``**`` tighter than a unary minus
+    on its left (-2**2 == -4).
+    """
+
+    def __init__(self, tokens):
+        self._tokens = tokens
+        self._pos = 0
+
+    # -- helpers ---------------------------------------------------------
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return None
+
+    def _advance(self):
+        token = self._peek()
+        self._pos += 1
+        return token
+
+    @staticmethod
+    def _is_operand_start(token):
+        return token == "(" or (isinstance(token, tuple) and token[0] == "num")
+
+    # -- grammar ---------------------------------------------------------
+    def parse(self):
+        value = self._expression()
+        if self._pos != len(self._tokens):
+            raise ValueError("unexpected token: %r" % (self._peek(),))
+        return value
+
