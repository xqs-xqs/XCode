 """Implement the functions declared below; keep the signatures unchanged."""
+import re
+
+_RANGE_RE = re.compile(r"^(-?\d+)\s*-\s*(-?\d+)$")
+_SINGLE_RE = re.compile(r"^-?\d+$")
+
+
 def compress(numbers) -> str:
-    raise NotImplementedError
+    values = sorted(set(numbers))
+    parts = []
+    index = 0
+    while index < len(values):
+        start = values[index]
+        end = start
+        while index + 1 < len(values) and values[index + 1] == end + 1:
+            index += 1
+            end = values[index]
+        length = end - start + 1
+        if length >= 3:
+            parts.append(f"{start}-{end}")
+        else:
+            parts.extend(str(value) for value in values[index - length + 1:index + 1])
+        index += 1
+    return ",".join(parts)
+
 
 def expand(text: str) -> list:
-    raise NotImplementedError
+    if not text.strip():
+        return []
+    result = set()
