+# A full version: exactly three numbers, no leading zeros.
+_FULL_RE = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$")
+
+# A comparator version: one to three numbers, no leading zeros.
+_PARTIAL_RE = re.compile(
+    r"^(0|[1-9][0-9]*)(?:\.(0|[1-9][0-9]*))?(?:\.(0|[1-9][0-9]*))?$"
