 """Implement the functions declared below; keep the signatures unchanged."""
+
+import heapq
+
+_UNVISITED = 0
+_ON_STACK = 1
+_DONE = 2
+
+
+def _format_cycle(cycle_path: list) -> str:
+    """Render a cycle (given as a path whose last node repeats the first)."""
+    body = cycle_path[:-1]
+    start = body.index(min(body))
+    body = body[start:] + body[:start]
+    return " -> ".join(body + [body[0]])
+
+
+def _find_cycle(deps: dict, remaining) -> str:
+    """Return the message for one dependency cycle among `remaining` nodes."""
+    state = {name: _UNVISITED for name in remaining}
+    path = []
+    for start in sorted(remaining):
+        if state[start] != _UNVISITED:
+            continue
+        state[start] = _ON_STACK
+        path.append(start)
+        stack = [(start, iter(sorted(deps[start])))]
+        while stack:
+            node, successors = stack[-1]
+            descended = False
+            for nxt in successors:
+                if state[nxt] == _ON_STACK:
+                    return _format_cycle(path[path.index(nxt):] + [nxt])
+                if state[nxt] == _UNVISITED:
+                    state[nxt] = _ON_STACK
+                    path.append(nxt)
+                    stack.append((nxt, iter(sorted(deps[nxt]))))
+                    descended = True
+                    break
+            if not descended:
+                stack.pop()
+                state[node] = _DONE
+                path.pop()
+    raise AssertionError("no cycle found")  # pragma: no cover
+
