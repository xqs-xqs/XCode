+
+    match = _PATTERN.fullmatch(text)
+    if match is None:
+        raise ValueError(f"malformed decimal: {text!r}")
+
+    negative = match.group(1) == "-"
+    int_part = match.group(2)
+    frac_part = match.group(3) or ""
+
+    # Work on the digit string only, tracking the decimal exponent separately.
+    digits = int_part + frac_part
