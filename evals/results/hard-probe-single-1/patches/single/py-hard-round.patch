 """Implement the functions declared below; keep the signatures unchanged."""
+
+import re
+
+# Optional '-', one or more digits, optionally '.' plus one or more digits.
+# ASCII-only: \d would also accept non-ASCII digits, which are not valid here.
+_PATTERN = re.compile(r"(-?)([0-9]+)(?:\.([0-9]+))?")
+
+
+def _increment(digits: str) -> str:
+    """Add one to a string of ASCII digits (may grow by one digit)."""
+    out = list(digits)
+    i = len(out) - 1
+    while i >= 0:
+        if out[i] == "9":
+            out[i] = "0"
+            i -= 1
+        else:
+            out[i] = chr(ord(out[i]) + 1)
+            return "".join(out)
+    return "1" + "".join(out)
+
+
 def round_decimal(text: str, places: int) -> str:
