 def to_roman(number: int) -> str:
-    raise NotImplementedError
+    """Convert an int in 1..3999 to its canonical upper-case Roman numeral."""
+    if isinstance(number, bool) or not isinstance(number, int):
+        raise TypeError("number must be an int")
+    if not 1 <= number <= 3999:
+        raise ValueError("number must be between 1 and 3999")
+
+    parts = []
+    remaining = number
+    for value, glyph in _VALUES:
+        count, remaining = divmod(remaining, value)
+        if count:
+            parts.append(glyph * count)
+    return "".join(parts)
+
+
+# Every string to_roman can produce, mapped back to its value.
+_ROMAN_TO_INT = {to_roman(n): n for n in range(1, 4000)}
+
 
