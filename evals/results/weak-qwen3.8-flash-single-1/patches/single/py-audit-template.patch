index 0000000000000000000000000000000000000000..c1fc7d95b6e8f3ac0f3598111a75acd9b7ad4cb3
--- /dev/null
+++ b/_tmp_check.py
@@ -0,0 +1,71 @@
+from solution import render
+
+ok = 0
+fail = []
+
+
+def eq(t, v, e):
+    global ok
+    r = render(t, v)
+    if r == e:
+        ok += 1
+    else:
+        fail.append(("value", t, v, e, r))
+
+
+def err(t, v, exc):
+    global ok
+    try:
+        r = render(t, v)
+    except exc:
+        ok += 1
+    except Exception as ex:
+        fail.append(("wrong-exc", t, v, exc, ex))
+    else:
+        fail.append(("no-exc", t, v, exc, r))
+
+
+eq("{v}", {"v": "Ab"}, "Ab")
+eq("{v|upper|lower}", {"v": "Ab"}, "ab")
+eq("{v|lower|upper}", {"v": "Ab"}, "AB")
+eq("Hi { name | upper }!", {"name": "x"}, "Hi X!")
+eq("{user.name}", {"user": {"name": "bo"}}, "bo")
+eq("{a.b.c}", {"a": {"b": {"c": 5}}}, "5")
+eq("{{}}", {}, "{}")
+eq("a{{b}}c", {"x": 1}, "a{b}c")
+eq("{{{v}}}", {"v": "z"}, "{z}")
+eq("{v|trim|upper}", {"v": "  ab "}, "AB")
+eq("{v|title}", {"v": "a b c"}, "A B C")
+eq("", {}, "")
+eq("plain text", {"x": 1}, "plain text")
+eq("{v}", {"v": 12}, "12")
+eq("{v|trim}", {"v": "  y "}, "y")
+eq("{v|upper|trim}", {"v": " ab "}, "AB")
+eq("{a.b|upper}", {"a": {"b": "c"}}, "C")
+eq("{v|upper|lower|title|trim}", {"v": " a b "}, "A B")
+eq("{v| trim | upper }", {"v": " q "}, "Q")
+err("{v|x}", {"v": "a"}, ValueError)
+err("{v|}", {"v": "a"}, ValueError)
+err("{v||upper}", {"v": "a"}, ValueError)
+err("{}", {}, ValueError)
+err("{  }", {}, ValueError)
+err("{v", {}, ValueError)
+err("a}b", {}, ValueError)
+err("}", {}, ValueError)
+err("}}}", {}, ValueError)
+err("abc}", {}, ValueError)
+err("{ upper}", {}, ValueError)
+err("{a..b}", {"a": {"b": 1}}, ValueError)
+err("{.a}", {"a": 1}, ValueError)
+err("{a.}", {"a": 1}, ValueError)
+err("{a b}", {"a b": 1}, ValueError)
+err("{a-b}", {"a-b": 1}, ValueError)
+err("{missing}", {}, KeyError)
+err("{a.b}", {"a": 5}, KeyError)
+err("{a.b}", {"a": "str"}, KeyError)
+err("{a.b}", {"a": [1]}, KeyError)
+err("{a.b.c}", {"a": {"b": "x"}}, KeyError)
+
+print("passed", ok, "failed", len(fail))
+for f in fail:
+    print("FAIL", f)
