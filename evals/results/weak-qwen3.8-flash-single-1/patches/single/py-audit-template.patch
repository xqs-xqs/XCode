diff --git a/tmp_spec_test.py b/tmp_spec_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..9a4d9746aac4cb8c03cf6def2942873e8f2f57c0
--- /dev/null
+++ b/tmp_spec_test.py
@@ -0,0 +1,64 @@
+import unittest
+
+from solution import render
+
+
+class SpecTest(unittest.TestCase):
+    def test_values_ok(self):
+        cases = [
+            ("{v}", {"v": "Ab"}, "Ab"),
+            ("{v|upper|lower}", {"v": "Ab"}, "ab"),
+            ("{v|lower|upper}", {"v": "Ab"}, "AB"),
+            ("Hi { name | upper }!", {"name": "x"}, "Hi X!"),
+            ("{user.name}", {"user": {"name": "bo"}}, "bo"),
+            ("{a.b.c}", {"a": {"b": {"c": 5}}}, "5"),
+            ("{{}}", {}, "{}"),
+            ("a{{b}}c", {"x": 1}, "a{b}c"),
+            ("{{{v}}}", {"v": "z"}, "{z}"),
+            ("{v|trim|upper}", {"v": "  ab "}, "AB"),
+            ("{v|title}", {"v": "a b c"}, "A B C"),
+            ("", {}, ""),
+            ("plain text", {"x": 1}, "plain text"),
+            ("{v}", {"v": 12}, "12"),
+            ("{v|trim}", {"v": "  y "}, "y"),
+            ("{v|upper|trim}", {"v": " ab "}, "AB"),
+            ("{a.b|upper}", {"a": {"b": "c"}}, "C"),
+            ("{v|upper|lower|title|trim}", {"v": " a b "}, "A B"),
+            ("{v| trim | upper }", {"v": " q "}, "Q"),
+            ("{{a}}", {}, "{a}"),
+            ("{{x}}", {}, "{x}"),
+            ("{a.b|upper|trim}", {"a": {"b": " x "}}, "X"),
+            ("{v|title|lower}", {"v": "A B"}, "a b"),
+            ("{v|trim|title|upper}", {"v": " a b "}, "A B"),
+            ("x{{y}}z{v}", {"v": "!"}, "x{y}z!"),
+        ]
+        for template, values, expected in cases:
+            with self.subTest(template=template):
+                self.assertEqual(render(template, values), expected)
+
+    def test_errors(self):
+        bad = [
+            "{v|x}", "{v|}", "{v||upper}", "{}", "{  }", "{v", "a}b", "}", "}}}",
+            "abc}", "{a..b}", "{.a}", "{a.}", "{a b}", "{a-b}",
+        ]
+        for template in bad:
+            with self.subTest(template=template):
+                self.assertRaises(ValueError, render, template, {"v": "a", "a": {"b": 1}})
+
+    def test_key_errors(self):
+        bad = [
+            ("{missing}", {}),
+            ("{a.b}", {"a": 5}),
+            ("{a.b}", {"a": "str"}),
+            ("{a.b}", {"a": [1]}),
+            ("{a.b.c}", {"a": {"b": "x"}}),
+            ("{a.b}", {"a": {}}),
+            ("{a}", {}),
+        ]
+        for template, values in bad:
+            with self.subTest(template=template, values=values):
+                self.assertRaises(KeyError, render, template, values)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tmp_visible_check.py b/tmp_visible_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..8cdb26fce0769726b4ef1a72e54fc22d6089bdea
--- /dev/null
+++ b/tmp_visible_check.py
@@ -0,0 +1,33 @@
+"""Report pass/fail for every assertion written in test_visible.py."""
+
+from solution import render
+
+def _raises(kind, fn, *args):
+    try:
+        fn(*args)
+    except kind:
+        return f"raised {kind.__name__}"
+    return f"FAIL: no {kind.__name__}"
+
+
+def _show(fn):
+    try:
+        return repr(fn())
+    except Exception as error:  # noqa: BLE001
+        return f"{type(error).__name__}: {error}"
+
+
+print("filters chain:", _show(lambda: render("{v|upper|lower}", {"v": "Ab"})), "expected 'ab'")
+print("escape {{x}}:", _show(lambda: render("{{x}}", {})), "visible expects '{' (spec -> '{x}')")
+print("lone }}:", _show(lambda: render("a}}b", {})))
+print("lone }:", _raises(ValueError, render, "}", {}))
+print("spaces:", _show(lambda: render("{ name | upper }", {"name": " ada "})), "expected 'ADA'")
+print("dotted:", _show(lambda: render("{a.b}", {"a": {"b": 2}})), "expected '2'")
+print("missing:", _raises(KeyError, render, "{x}", {"y": 1}))
+print("walk non-dict:", _raises(KeyError, render, "{a.b}", {"a": 1}))
+print("empty filter:", _raises(ValueError, render, "{a|}", {}))
+print("unknown filter:", _raises(ValueError, render, "{a|nope}", {}))
+print("empty placeholder:", _raises(ValueError, render, "{}", {}))
+print("unclosed:", _raises(ValueError, render, "{a", {}))
+print("malformed:", _raises(ValueError, render, "{a-b}", {}))
+print("chain trim/title:", _show(lambda: render("{ v | trim | title }", {"v": "  jo e  "})))
