@@ -0,0 +1,27 @@
+import unittest
+
+from solution import compress, expand
+
+
+class TestExtra(unittest.TestCase):
+    def test_compress(self):
+        self.assertEqual(compress([]), "")
+        self.assertEqual(compress([-3, -2, -1]), "-3--1")
+        self.assertEqual(compress([1, 1, 2, 4, 5, 6, 7]), "1,2,4-7")
+        self.assertEqual(compress(iter([3, 2, 1])), "1-3")
+
+    def test_expand(self):
+        self.assertEqual(expand(""), [])
+        self.assertEqual(expand("   "), [])
+        self.assertEqual(expand(" 4-4 , 1-2 ,2"), [1, 2, 4])
+        self.assertEqual(expand("-3--1, 5"), [-3, -2, -1, 5])
+        self.assertEqual(expand("3,1,2"), [1, 2, 3])
+
+    def test_errors(self):
+        for bad in ["5-3", "1,,2", ",1", "1,", "a", "1-2-3", "1--2", "--1", "1-"]:
+            with self.assertRaises(ValueError):
+                expand(bad)
+
+
+if __name__ == "__main__":
+    unittest.main()
