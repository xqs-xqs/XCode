 """Implement the functions declared below; keep the signatures unchanged."""
+import re
+
+_ITEM_RE = re.compile(r"^\s*(-?\d+)\s*(?:-\s*(-?\d+)\s*)?$")
+
+
 def compress(numbers) -> str:
-    raise NotImplementedError
+    values = sorted(set(numbers))
+    parts = []
+    i = 0
+    while i < len(values):
+        j = i
+        while j + 1 < len(values) and values[j + 1] == values[j] + 1:
+            j += 1
+        if j - i >= 2:
+            parts.append(f"{values[i]}-{values[j]}")
+        else:
+            parts.extend(str(values[k]) for k in range(i, j + 1))
+        i = j + 1
+    return ",".join(parts)
+
 
 def expand(text: str) -> list:
-    raise NotImplementedError
+    if text is None or not text.strip():
+        return []
+    result = set()
+    for raw in text.split(","):
+        item = raw.strip()
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        match = _ITEM_RE.match(item)
+        if not match:
+            raise ValueError(f"invalid item {item!r}")
+        start = int(match.group(1))
+        end_text = match.group(2)
+        if end_text is None:
+            result.add(start)
+            continue
+        end = int(end_text)
+        if end < start:
+            raise ValueError(f"descending range {item!r}")
+        result.update(range(start, end + 1))
+    return sorted(result)
 
