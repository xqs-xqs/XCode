 """Implement the functions declared below; keep the signatures unchanged."""
+import re
+
+_SEGMENT = re.compile(r"^[A-Za-z0-9_]+$")
+
+_FILTERS = {
+    "upper": str.upper,
+    "lower": str.lower,
+    "title": str.title,
+    "trim": str.strip,
+}
+
+
+def _resolve(name: str, values) -> str:
+    segments = [segment.strip() for segment in name.split(".")]
+    for segment in segments:
+        if not _SEGMENT.match(segment):
+            raise ValueError("malformed name: %r" % (name,))
+    current = values
+    for segment in segments:
+        if not isinstance(current, dict):
+            raise KeyError(segment)
+        if segment not in current:
+            raise KeyError(segment)
+        current = current[segment]
+    return str(current)
+
+
