+def _find_cycle(nodes, deps):
+    """Return one dependency cycle among ``nodes`` as a list of names."""
+    color = {}
+    for start in sorted(nodes):
+        if color.get(start):
+            continue
+        color[start] = 1
+        path = [start]
+        stack = [(start, iter(sorted(d for d in deps[start] if d in nodes)))]
+        while stack:
+            node, it = stack[-1]
+            advanced = False
+            for nxt in it:
+                state = color.get(nxt, 0)
+                if state == 0:
+                    color[nxt] = 1
+                    path.append(nxt)
+                    stack.append((nxt, iter(sorted(d for d in deps[nxt] if d in nodes))))
+                    advanced = True
+                    break
+                if state == 1:
+                    return path[path.index(nxt):]
+            if not advanced:
+                color[node] = 2
+                stack.pop()
+                path.pop()
+    return []
+
