 def topological_order(nodes: list, edges: list):
-    raise NotImplementedError
+    """Return nodes in topological order, smallest name first among ties.
+
+    Returns None if the graph contains a cycle, and raises ValueError if an
+    edge references a node that is not listed in ``nodes``.
+    """
+    unique_nodes = set(nodes)
+    indegree = {node: 0 for node in unique_nodes}
+    successors = {node: [] for node in unique_nodes}
+
+    for edge in edges:
+        source, target = edge[0], edge[1]
+        if source not in unique_nodes or target not in unique_nodes:
+            raise ValueError(f"edge references unknown node: {edge!r}")
+        successors[source].append(target)
+        indegree[target] += 1
+
+    available = [node for node in unique_nodes if indegree[node] == 0]
+    heapq.heapify(available)
+
+    order = []
+    while available:
+        node = heapq.heappop(available)
+        order.append(node)
+        for successor in successors[node]:
+            indegree[successor] -= 1
+            if indegree[successor] == 0:
+                heapq.heappush(available, successor)
+
+    if len(order) != len(unique_nodes):
+        return None
+    return order
 
