 }
 
 // Tokens reports the current token level.
 func (b *TokenBucket) Tokens() float64 {
-	panic("not implemented")
+	b.refill()
+	return b.tokens
+}
+
+// refill adds the tokens accrued since the last observation, capped at capacity.
+func (b *TokenBucket) refill() {
+	now := b.clock()
+	elapsed := now - b.last
+	if elapsed <= 0 {
+		return
+	}
+	b.last = now
+	b.tokens += elapsed * b.rate
+	if b.tokens > b.capacity {
+		b.tokens = b.capacity
+	}
 }
