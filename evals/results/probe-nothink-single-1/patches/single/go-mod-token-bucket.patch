 }
 
 // Allow removes count tokens and reports whether they were available.
 func (b *TokenBucket) Allow(count int) (bool, error) {
-	panic("not implemented")
+	if count < 1 {
+		return false, ErrParameter
+	}
+	b.refill()
+	want := float64(count)
+	if b.tokens < want {
+		return false, nil
+	}
+	b.tokens -= want
