+            j = i
+            while j < n and text[j] in _DIGITS:
+                j += 1
+            tokens.append(("num", int(text[i:j])))
+            i = j
+            continue
+        if ch == "*":
+            if text.startswith("**", i):
+                tokens.append(("op", "**"))
+                i += 2
+            else:
+                tokens.append(("op", "*"))
+                i += 1
+            continue
+        if ch == "/":
+            if text.startswith("//", i):
+                tokens.append(("op", "//"))
+                i += 2
+                continue
