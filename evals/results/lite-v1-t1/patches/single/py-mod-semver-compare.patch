 def _parts(version: str) -> list:
-    raise NotImplementedError
+    """Split a dotted numeric version into a list of ints.
+
+    A single leading 'v'/'V' prefix is ignored. Raises ValueError for an
+    empty string or for any component that is not purely numeric.
+    """
+    if not isinstance(version, str) or not version:
+        raise ValueError("version must be a non-empty string")
+
+    if version[0] in ("v", "V"):
+        version = version[1:]
+
+    parts = []
+    for component in version.split("."):
+        if not component.isascii() or not component.isdigit():
+            raise ValueError(f"non-numeric version component: {component!r}")
+        parts.append(int(component))
+    return parts
+
 
