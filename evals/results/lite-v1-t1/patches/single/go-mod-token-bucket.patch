 // Tokens reports the current token level.
 func (b *TokenBucket) Tokens() float64 {
-	panic("not implemented")
+	b.refill()
+	return b.tokens
+}
+
+// now reports the current clock time, tolerating a missing clock.
+func (b *TokenBucket) now() float64 {
+	if b.clock == nil {
+		return 0
+	}
+	return b.clock()
+}
+
+// refill adds the tokens accrued since the previous refill, capped at capacity.
+func (b *TokenBucket) refill() {
+	now := b.now()
+	elapsed := now - b.last
+	if elapsed <= 0 {
+		return
+	}
+	b.last = now
+	b.tokens += elapsed * b.rate
+	if b.tokens > b.capacity {
+		b.tokens = b.capacity
+	}
 }
