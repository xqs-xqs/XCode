 // TokenBucket refills at rate tokens per second, up to capacity, using clock.
 type TokenBucket struct {
+	rate     float64
+	capacity float64
+	clock    func() float64
+
+	tokens float64
+	last   float64
 }
 
 // NewTokenBucket builds a bucket that starts full.
