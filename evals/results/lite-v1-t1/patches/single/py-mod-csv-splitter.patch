 """Implement the functions declared below; keep the signatures unchanged."""
 def split_line(line: str) -> list:
-    raise NotImplementedError
+    """Split one CSV record into fields.
+
+    Commas separate fields; a double-quoted field may contain commas and
+    doubled quotes (``""`` standing for one literal quote). Empty fields
+    become ``""``. A quoted field that is never closed raises ``ValueError``.
+    """
+    fields = []
+    field = []
+    in_quotes = False
+    i = 0
+    n = len(line)
+
+    while i < n:
+        ch = line[i]
+
+        if in_quotes:
+            if ch == '"':
+                if i + 1 < n and line[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+                i += 1
+                continue
+            field.append(ch)
+            i += 1
+            continue
+
+        if ch == '"':
+            in_quotes = True
+            i += 1
+            continue
+
+        if ch == ',':
+            fields.append(''.join(field))
+            field = []
+            i += 1
+            continue
+
+        field.append(ch)
+        i += 1
+
+    if in_quotes:
+        raise ValueError("unterminated quoted field")
+
+    fields.append(''.join(field))
+    return fields
 
