 """Implement the functions declared below; keep the signatures unchanged."""
+from collections import OrderedDict
+
+
 class TTLCache:
-    pass
+    """LRU cache whose entries expire ``ttl`` seconds after being set.
+
+    ``clock`` is a zero-argument callable returning the current time in
+    seconds; it is injected so callers control the passage of time.
+    """
+
+    def __init__(self, capacity, ttl, clock):
+        if capacity <= 0:
+            raise ValueError("capacity must be positive")
+        if ttl <= 0:
+            raise ValueError("ttl must be positive")
+        self.capacity = capacity
+        self.ttl = ttl
+        self.clock = clock
+        # key -> (value, expires_at); ordered from least to most recently used.
+        self._entries = OrderedDict()
+
+    def _expired(self, expires_at, now):
+        return now >= expires_at
+
+    def _purge(self, now):
+        """Drop every entry whose lifetime has elapsed."""
+        dead = [key for key, (_, exp) in self._entries.items()
+                if self._expired(exp, now)]
+        for key in dead:
+            del self._entries[key]
+
+    def set(self, key, value):
+        now = self.clock()
+        self._entries.pop(key, None)
+        self._entries[key] = (value, now + self.ttl)
+        self._entries.move_to_end(key)
+        self._purge(now)
+        while len(self._entries) > self.capacity:
+            self._entries.popitem(last=False)
+
+    def get(self, key, default=None):
+        now = self.clock()
+        entry = self._entries.get(key)
+        if entry is None:
+            return default
+        value, expires_at = entry
+        if self._expired(expires_at, now):
+            del self._entries[key]
+            return default
+        self._entries.move_to_end(key)
+        return value
+
+    def __len__(self):
+        self._purge(self.clock())
+        return len(self._entries)
+
 
