 }
 
 // Tokens reports the current token level.
 func (b *TokenBucket) Tokens() float64 {
-	panic("not implemented")
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	b.refill()
+	return b.tokens
+}
+
+// refill adds tokens for the time elapsed since the last observation, capped at
+// capacity. It must be called with b.mu held.
+func (b *TokenBucket) refill() {
+	now := b.clock()
+	elapsed := now - b.last
+	if elapsed <= 0 {
+		return
+	}
+	b.last = now
+	b.tokens += elapsed * b.rate
+	if b.tokens > b.capacity {
+		b.tokens = b.capacity
+	}
 }
