+    """Order nodes so every edge (source, target) has source before target.
+
+    Ties are broken by picking the alphabetically smallest available node.
+    Returns None if the graph contains a cycle and raises ValueError if an
+    edge references a node that is not part of ``nodes``.
+    """
+    order_nodes = list(dict.fromkeys(nodes))
+    known = set(order_nodes)
+
+    indegree = dict.fromkeys(order_nodes, 0)
+    successors = {node: [] for node in order_nodes}
+
+    for edge in edges:
+        source, target = edge
+        if source not in known:
+            raise ValueError(f"edge references unknown node: {source!r}")
+        if target not in known:
+            raise ValueError(f"edge references unknown node: {target!r}")
+        successors[source].append(target)
+        indegree[target] += 1
+
+    available = [node for node in order_nodes if indegree[node] == 0]
+    heapq.heapify(available)
+
+    result = []
+    while available:
+        node = heapq.heappop(available)
+        result.append(node)
+        for successor in successors[node]:
+            indegree[successor] -= 1
+            if indegree[successor] == 0:
+                heapq.heappush(available, successor)
+
+    if len(result) != len(order_nodes):
+        return None
+    return result
 
