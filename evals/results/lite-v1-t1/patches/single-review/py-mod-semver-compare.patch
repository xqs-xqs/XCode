 """Implement the functions declared below; keep the signatures unchanged."""
 def _parts(version: str) -> list:
-    raise NotImplementedError
+    if not isinstance(version, str):
+        raise ValueError(f"version must be a string, got {type(version).__name__}")
+    text = version[1:] if version[:1] in ("v", "V") else version
+    if not text:
+        raise ValueError(f"empty version string: {version!r}")
+    parts = []
+    for chunk in text.split("."):
+        chunk = chunk.strip()
+        if not chunk or not chunk.isdigit():
+            raise ValueError(f"non-numeric component {chunk!r} in {version!r}")
+        parts.append(int(chunk))
+    return parts
+
 
 def compare(left: str, right: str) -> int:
-    raise NotImplementedError
+    a = _parts(left)
+    b = _parts(right)
+    width = max(len(a), len(b))
+    # Missing trailing components count as zero.
+    a.extend([0] * (width - len(a)))
+    b.extend([0] * (width - len(b)))
+    for x, y in zip(a, b):
+        if x != y:
+            return -1 if x < y else 1
+    return 0
 
