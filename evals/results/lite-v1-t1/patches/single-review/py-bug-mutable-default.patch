+def collect(items, target=None):
+    """Append the items that are not already present and return the target list.
+
+    A fresh list is created per call when no target is supplied, so results never
+    leak between calls. An explicitly supplied target list is appended to in place.
+    """
+    if target is None:
+        target = []
     for item in items:
         if item not in target:
             target.append(item)
