 """Implement the functions declared below; keep the signatures unchanged."""
+
+COMMENT_STARTS = ("#", ";")
+
+
 def parse_ini(text: str) -> dict:
-    raise NotImplementedError
+    """Parse a small INI-style configuration.
+
+    Returns ``{section: {key: value}}``. Keys appearing before the first
+    header land in the section with the empty name ``""``.
+    """
+    sections: dict = {}
+    current = ""
+
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith(COMMENT_STARTS):
+            continue
+
+        if line.startswith("[") and line.endswith("]"):
+            current = line[1:-1].strip()
+            sections.setdefault(current, {})
+        elif "=" in line:
+            key, _, value = line.partition("=")
+            sections.setdefault(current, {})[key.strip()] = value.strip()
+        else:
+            raise ValueError(f"invalid line: {raw_line!r}")
+
+    return sections
 
