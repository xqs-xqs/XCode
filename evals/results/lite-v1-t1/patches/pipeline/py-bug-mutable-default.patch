@@ -0,0 +1,43 @@
+import unittest
+
+from solution import collect
+
+
+class TestInline(unittest.TestCase):
+    def test_inline(self):
+        a = collect([1, 2, 1])
+        b = collect([3])
+        print("a =", a)
+        print("b =", b)
+        print("a is b:", a is b)
+        self.assertEqual(a, [1, 2])
+        self.assertEqual(b, [3])
+        self.assertIs(a is b, False)
+
+        t = []
+        r = collect([1, 2, 1], t)
+        print("t =", t)
+        print("r is t:", r is t)
+        self.assertEqual(t, [1, 2])
+        self.assertIs(r is t, True)
+
+        after = collect([9])
+        print("collect([9]) after:", after)
+        self.assertEqual(after, [9])
+
+
+if __name__ == "__main__":
+    unittest.main()
+
+a = collect([1, 2, 1])
+b = collect([3])
+print("a =", a)
+print("b =", b)
+print("a is b:", a is b)
+
+t = []
+r = collect([1, 2, 1], t)
+print("t =", t)
+print("r is t:", r is t)
+
+print("collect([9]) after:", collect([9]))
