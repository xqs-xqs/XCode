--- a/solution.go
+++ b/solution.go
@@ -1,7 +1,11 @@
 package solution
 
 // Overlaps reports whether two closed integer intervals [aStart, aEnd] and
-// [bStart, bEnd] share at least one integer.
+// [bStart, bEnd] share at least one integer. Intervals that merely touch at a
+// single endpoint, e.g. [1,3] and [3,5], do overlap (at 3).
+//
+// Callers must pass non-inverted intervals (start <= end); the result is
+// unspecified otherwise.
 func Overlaps(aStart, aEnd, bStart, bEnd int) bool {
-	return aStart <= bEnd && bStart < aEnd
+	return aStart <= bEnd && bStart <= aEnd
 }
