 }
+
+// TestOverlapsClosedIntervalCases pins the closed-interval contract and checks
+// that Overlaps is symmetric (argument order must not matter).
+func TestOverlapsClosedIntervalCases(t *testing.T) {
+	// Each case is {aStart, aEnd, bStart, bEnd}.
+	overlapping := [][4]int{
+		// shares the single endpoint 3
+		{1, 3, 3, 5},
+		// same pair, arguments swapped
+		{3, 5, 1, 3},
+		// nested
+		{1, 10, 4, 6},
+		// degenerate point inside b
+		{3, 3, 3, 5},
+		// identical degenerate points
+		{3, 3, 3, 3},
+		// point at the far boundary
+		{1, 10, 10, 10},
+		// shared 0 across the sign boundary
+		{0, 0, -1, 0},
+		// negatives
+		{-5, -1, -3, 0},
+	}
+	for _, c := range overlapping {
+		if !Overlaps(c[0], c[1], c[2], c[3]) {
+			t.Errorf("Overlaps(%d,%d,%d,%d) = false, want true (closed intervals share an integer)",
+				c[0], c[1], c[2], c[3])
+		}
+		if !Overlaps(c[2], c[3], c[0], c[1]) {
+			t.Errorf("Overlaps(%d,%d,%d,%d) = false, want true (swapped arguments must agree)",
+				c[2], c[3], c[0], c[1])
+		}
+	}
+
+	disjoint := [][4]int{
+		// adjacent but no shared integer
+		{1, 3, 4, 5},
+		// gap of one
+		{1, 10, 11, 20},
+		// negative, no overlap
+		{-5, -3, -2, 0},
+	}
+	for _, c := range disjoint {
+		if Overlaps(c[0], c[1], c[2], c[3]) {
+			t.Errorf("Overlaps(%d,%d,%d,%d) = true, want false (no shared integer)",
+				c[0], c[1], c[2], c[3])
+		}
+		if Overlaps(c[2], c[3], c[0], c[1]) {
+			t.Errorf("Overlaps(%d,%d,%d,%d) = true, want false (swapped arguments must agree)",
+				c[2], c[3], c[0], c[1])
+		}
+	}
+}
