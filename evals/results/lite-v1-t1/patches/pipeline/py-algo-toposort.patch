 def topological_order(nodes: list, edges: list):
-    raise NotImplementedError
+    node_set = set(nodes)
+    for edge in edges:
+        src, dst = edge
+        if src not in node_set or dst not in node_set:
+            raise ValueError(f"edge {edge!r} references unknown node")
+
+    adj = {v: [] for v in node_set}
+    indeg = {v: 0 for v in node_set}
+    for src, dst in set(edges):
+        adj[src].append(dst)
+        indeg[dst] += 1
+
+    heap = [v for v in node_set if indeg[v] == 0]
+    heapq.heapify(heap)
+    order = []
+    while heap:
+        v = heapq.heappop(heap)
+        order.append(v)
+        for w in adj[v]:
+            indeg[w] -= 1
+            if indeg[w] == 0:
+                heapq.heappush(heap, w)
+    return order if len(order) == len(node_set) else None
 
