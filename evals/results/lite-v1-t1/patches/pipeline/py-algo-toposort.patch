+class AdHoc(unittest.TestCase):
+    def test_adhoc(self):
+        print(t(['a', 'b'], [('b', 'a')]))
+        print(t(['a', 'b'], [('a', 'b'), ('b', 'a')]))
+        print(t(['a'], [('a', 'a')]))
+        print(t(['a', 'b'], []))
