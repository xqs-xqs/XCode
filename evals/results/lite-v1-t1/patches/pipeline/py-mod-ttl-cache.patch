 """Implement the functions declared below; keep the signatures unchanged."""
+from collections import OrderedDict
+
+
 class TTLCache:
-    pass
+    """LRU cache whose entries also expire after a fixed ttl."""
+
+    def __init__(self, capacity, ttl, clock):
+        if capacity <= 0:
+            raise ValueError("capacity must be positive")
+        if ttl <= 0:
+            raise ValueError("ttl must be positive")
+        self._capacity = capacity
+        self._ttl = ttl
+        self._clock = clock
+        self._data = OrderedDict()
+
+    def _purge_expired(self, now):
+        for key, (_, expires_at) in list(self._data.items()):
+            if now >= expires_at:
+                del self._data[key]
+
+    def set(self, key, value):
+        now = self._clock()
+        self._purge_expired(now)
+        self._data[key] = (value, now + self._ttl)
+        self._data.move_to_end(key)
+        while len(self._data) > self._capacity:
+            self._data.popitem(last=False)
+
+    def get(self, key, default=None):
+        if key not in self._data:
+            return default
+        value, expires_at = self._data[key]
+        if self._clock() >= expires_at:
+            del self._data[key]
+            return default
+        self._data.move_to_end(key)
+        return value
+
+    def __len__(self):
+        now = self._clock()
+        return sum(1 for _, expires_at in self._data.values() if now < expires_at)
 
