@@ -0,0 +1,75 @@
+import unittest
+
+from solution import TTLCache
+
+
+class TestHiddenBehaviour(unittest.TestCase):
+    def test_lru_and_capacity(self):
+        t = [0.0]
+        c = TTLCache(2, 10, lambda: t[0])
+        c.set('a', 1)
+        c.set('b', 2)
+        c.get('a')
+        c.set('c', 3)
+        self.assertEqual(c.get('b', 'MISS'), 'MISS')
+        self.assertEqual(c.get('a'), 1)
+        self.assertEqual(c.get('c'), 3)
+
+    def test_len_and_expiry(self):
+        t = [0.0]
+        c = TTLCache(2, 10, lambda: t[0])
+        c.set('a', 1)
+        c.set('b', 2)
+        self.assertEqual(len(c), 2)
+        t[0] = 10
+        self.assertEqual(len(c), 0)
+        self.assertIsNone(c.get('a'))
+        c.set('d', 4)
+        self.assertEqual(len(c), 1)
+        t[0] = 19
+        self.assertEqual(len(c), 1)
+        t[0] = 20
+        self.assertEqual(len(c), 0)
+
+    def test_invalid_arguments(self):
+        for cap, ttl in ((0, 10), (-1, 10), (2, 0), (2, -1)):
+            with self.assertRaises(ValueError):
+                TTLCache(cap, ttl, lambda: 0.0)
+
+    def test_falsy_values(self):
+        c = TTLCache(2, 10, lambda: 0.0)
+        c.set('n', None)
+        c.set('z', 0)
+        self.assertIsNone(c.get('n', 7))
+        self.assertEqual(c.get('z', 7), 0)
+
+    def test_reset_refreshes_ttl_and_recency(self):
+        t = [0.0]
+        c = TTLCache(2, 10, lambda: t[0])
+        c.set('a', 1)
+        c.set('b', 2)
+        t[0] = 5
+        c.set('a', 11)
+        c.set('c', 3)
+        self.assertEqual(c.get('b', 'MISS'), 'MISS')
+        self.assertEqual(c.get('a'), 11)
+        t[0] = 14
+        self.assertEqual(len(c), 1)
+        self.assertIsNone(c.get('a'))
+        self.assertEqual(c.get('c'), 3)
+
+    def test_expired_entries_do_not_consume_capacity(self):
+        t = [0.0]
+        c = TTLCache(2, 10, lambda: t[0])
+        c.set('a', 1)
+        t[0] = 5
+        c.set('b', 2)
+        t[0] = 10  # 'a' expired, 'b' live
+        c.set('c', 3)
+        self.assertIsNone(c.get('a'))
+        self.assertEqual(c.get('b'), 2)
+        self.assertEqual(c.get('c'), 3)
+
+
+if __name__ == '__main__':
+    unittest.main()
