 """Implement the functions declared below; keep the signatures unchanged."""
+
+import time
+
+
 class TokenBucket:
-    pass
+    """Token bucket rate limiter refilled lazily from an injected clock."""
+
+    def __init__(self, rate, capacity, clock=None):
+        if rate <= 0:
+            raise ValueError("rate must be positive")
+        if capacity <= 0:
+            raise ValueError("capacity must be positive")
+        self.rate = float(rate)
+        self.capacity = float(capacity)
+        self._clock = clock if clock is not None else time.monotonic
+        self._tokens = self.capacity
+        self._last = self._clock()
+
+    def _refill(self):
+        now = self._clock()
+        elapsed = now - self._last
+        self._last = now
+        if elapsed > 0:
+            self._tokens = min(self.capacity, self._tokens + elapsed * self.rate)
+
+    def allow(self, count):
+        if count < 1:
+            raise ValueError("count must be at least one")
+        self._refill()
+        if self._tokens + 1e-9 >= count:
+            self._tokens = max(0.0, self._tokens - count)
+            return True
+        return False
+
+    def tokens(self):
+        self._refill()
+        return self._tokens
 
