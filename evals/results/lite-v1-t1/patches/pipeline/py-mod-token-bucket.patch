diff --git a/_verify_tmp.py b/_verify_tmp.py
new file mode 100644
index 0000000000000000000000000000000000000000..ca044a31a2fff1088d4fbb7339246796f20fd7a6
--- /dev/null
+++ b/_verify_tmp.py
@@ -0,0 +1,55 @@
+import solution
+B = solution.TokenBucket
+
+class Clock:
+    def __init__(self): self.t = 0.0
+    def __call__(self): return self.t
+
+res = []
+def chk(name, cond): res.append((name, bool(cond)))
+
+c = Clock(); b = B(rate=1, capacity=5, clock=c)
+chk("starts full", b.tokens() == 5)
+
+for kw in ({"rate":0}, {"rate":-1}, {"capacity":0}, {"capacity":-2}):
+    args = dict(rate=1, capacity=1); args.update(kw)
+    try:
+        B(clock=c, **args); chk("ValueError "+str(kw), False)
+    except ValueError: chk("ValueError "+str(kw), True)
+
+c = Clock(); b = B(rate=1, capacity=3, clock=c)
+for n in (0, -3):
+    try:
+        b.allow(n); chk("ValueError allow %d" % n, False)
+    except ValueError: chk("ValueError allow %d" % n, True)
+
+c = Clock(); b = B(rate=1, capacity=3, clock=c)
+chk("drain all", b.allow(3))
+chk("empty -> False", b.allow(1) is False)
+chk("untouched after fail", b.tokens() == 0)
+
+c = Clock(); b = B(rate=2, capacity=2, clock=c)
+b.allow(2); c.t = 10.0
+chk("clamped to capacity", b.tokens() == 2)
+
+c = Clock(); b = B(rate=0.5, capacity=10, clock=c)
+b.allow(10); c.t = 2.0
+chk("fractional refill 1.0", b.tokens() == 1.0)
+
+c = Clock(); b = B(rate=0.1, capacity=10, clock=c)
+b.allow(10); c.t = 3.0
+before = b.tokens()
+chk("accrued 0.3", abs(before - 0.3) < 1e-9)
+chk("allow 1 False when short", b.allow(1) is False)
+chk("untouched after short", b.tokens() == before)
+
+c = Clock(); b = B(rate=1, capacity=2, clock=c)
+chk("allow exactly capacity", b.allow(2) is True)
+chk("exhausted", b.tokens() == 0)
+
+b2 = B(rate=1, capacity=1)
+chk("default clock constructs", b2.tokens() == 1)
+
+for name, ok in res:
+    print(("PASS  " if ok else "FAIL  ") + name)
+print("SUMMARY", sum(ok for _, ok in res), "/", len(res), "passed")
