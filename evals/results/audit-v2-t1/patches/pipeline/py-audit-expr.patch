--- /dev/null
+++ b/probe_test.py
@@ -0,0 +1,72 @@
+"""Probe: exercises the full specification surface of evaluate()."""
+
+import unittest
+
+from solution import evaluate
+
+
+class TestValues(unittest.TestCase):
+    def check(self, cases):
+        for src, expected in cases:
+            with self.subTest(src=src):
+                got = evaluate(src)
+                self.assertEqual(got, expected)
+                self.assertIs(type(got), int)
+
+    def test_floor_modulo_signs(self):
+        self.check([("-7 % 3", 2), ("7 % -3", -2), ("-7 % -3", -1),
+                    ("10 % 3", 1), ("2 % 3", 2), ("2*3%4", 2),
+                    ("2*-3%5", 2 * -3 % 5)])
+
+    def test_floor_division_signs(self):
+        self.check([("7 // 2", 3), ("7 // -2", -4), ("-7 // 2", -4),
+                    ("-7 // -2", 3), ("-2//3", -1), ("8//3//2", 1),
+                    ("1//1", 1)])
+
+    def test_large_integers_stay_exact(self):
+        self.check([("10**20 // 3", 10**20 // 3),
+                    ("10**20 % 7", 10**20 % 7),
+                    ("10**30 + 1", 10**30 + 1)])
+
+    def test_power_associativity_and_precedence(self):
+        self.check([("-2**2", -4), ("2**3**2", 512),
+                    ("2**(1+1)", 4), ("(2)**2", 4), ("2 ** 3", 8),
+                    ("2**2**3", 256), ("3**2**2", 81), ("1**1**1", 1),
+                    ("0**0", 1), ("2**0", 1), ("1**1**1", 1),
+                    ("-2**2+10", 6)])
+
+    def test_associativity_and_unary(self):
+        self.check([("1-2-3", -4), ("--3", 3), ("-(-3)", 3),
+                    ("((2))", 2), ("-0", 0), ("2*-3", -6), ("2--3", 5),
+                    ("-3*-3", 9), ("((((1))))", 1), ("  1  ", 1)])
+
+    def test_basic_precedence(self):
+        self.check([("1 + 2 * 3", 7), ("(1 + 2) * 3", 9)])
+
+
+class TestSyntaxErrors(unittest.TestCase):
+    def assertRaisesExact(self, src, exc_type):
+        with self.subTest(src=src):
+            with self.assertRaises(exc_type) as ctx:
+                evaluate(src)
+            self.assertIs(type(ctx.exception), exc_type)
+
+    def test_value_errors(self):
+        for src in ["", "   ", "1+", "*3", "1/2", "1 + +2", "1 / / 2",
+                    "1 * * 2", "(1+2", "1+2)", "1 2", "1 2+3", "1$2",
+                    "()", "1.5", "//3", "+5", "(1+2))", "1)%2",
+                    "1\u0661", "@", "1 +", "2 %", "1..2", "1(()2"]:
+            self.assertRaisesExact(src, ValueError)
+
+    def test_negative_exponent(self):
+        for src in ["2**-1", "2**-3", "2**3**-1", "-2**-2",
+                    "(-2)**-1", "2**(0-1)"]:
+            self.assertRaisesExact(src, ValueError)
+
+    def test_division_by_zero(self):
+        for src in ["5%0", "5//0", "0//0", "(1+1)%(2-2)", "1//(3-3)"]:
+            self.assertRaisesExact(src, ZeroDivisionError)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
