+_NUMBER = re.compile(r"-?[0-9]+(?:\.[0-9]+)?")
+
+
+def _round_digits(digits: str, keep: int) -> str:
+    """Round digit string `digits` to its first `keep` digits, half-to-even."""
+    kept, tail = digits[:keep], digits[keep:]
+    if not tail:
+        return kept
+    head = tail[0]
+    if head > "5":
+        round_up = True
+    elif head < "5":
+        round_up = False
+    elif any(ch != "0" for ch in tail[1:]):
+        round_up = True
+    else:
+        round_up = int(kept[-1]) % 2 == 1
+    if not round_up:
+        return kept
+    out = []
+    carry = 1
+    for ch in reversed(kept):
+        value = int(ch) + carry
+        carry = value // 10
+        out.append(str(value % 10))
+    if carry:
+        out.append("1")
+    return "".join(reversed(out))
 
 
