+import unittest
+
+from solution import install_order
+
+
+class T(unittest.TestCase):
+    def test_all(self):
+        self.assertEqual(install_order({"c": [], "a": [], "b": []}), ["a", "b", "c"])
+        self.assertEqual(install_order({"a": ["b", "c"], "b": ["c"], "c": []}), ["c", "b", "a"])
+        self.assertEqual(install_order({"a": ["b", "b"], "b": []}), ["b", "a"])
+        with self.assertRaises(KeyError):
+            install_order({"a": ["x"], "x": []})
+        with self.assertRaises(ValueError) as cm:
+            install_order({"a": ["b"], "b": ["a"]})
+        self.assertEqual(str(cm.exception), "a -> b -> a")
+        with self.assertRaises(ValueError) as cm:
+            install_order({"a": ["a"]})
+        self.assertEqual(str(cm.exception), "a -> a")
+        with self.assertRaises(ValueError) as cm:
+            install_order({"c": ["a"], "b": ["c"], "a": ["b"]})
+        self.assertEqual(str(cm.exception), "a -> b -> c -> a")
+        with self.assertRaises(ValueError) as cm:
+            install_order({"z": ["y"], "y": ["z"], "q": []})
+        self.assertEqual(str(cm.exception), "y -> z -> y")
+        with self.assertRaises(ValueError) as cm:
+            install_order({"d": ["e"], "e": ["f"], "f": ["e"]})
+        self.assertEqual(str(cm.exception), "e -> f -> e")
+        d = {"a": ["b"], "b": []}
+        install_order(d)
+        self.assertEqual(d, {"a": ["b"], "b": []})
+        self.assertEqual(
+            install_order({"a": [], "b": ["a"], "c": ["a"], "d": ["b", "c"], "e": []}),
+            ["a", "e", "b", "c", "d"],
+        )
+        self.assertEqual(install_order({}), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
