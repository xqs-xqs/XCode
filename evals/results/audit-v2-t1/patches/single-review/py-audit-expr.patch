diff --git a/fuzz_check.py b/fuzz_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..b08a761a1ca08b892b54f8fb39dfbb5839e13812
--- /dev/null
+++ b/fuzz_check.py
@@ -0,0 +1,51 @@
+import random
+
+from solution import evaluate
+
+random.seed(7)
+
+
+def gen(depth=0):
+    # generate (text, python-equivalent-text)
+    r = random.random()
+    if depth > 3 or r < 0.3:
+        n = str(random.randint(0, 4))
+        if random.random() < 0.3:
+            return "-" + n, "(-" + n + ")"
+        return n, n
+    if r < 0.55:
+        a, pa = gen(depth + 1)
+        b, pb = gen(depth + 1)
+        op = random.choice(["+", "-", "*", "//", "%"])
+        return f"{a} {op} {b}", f"({pa} {op} {pb})"
+    if r < 0.7:
+        a, pa = gen(depth + 1)
+        return f"({a})", f"({pa})"
+    a, pa = gen(depth + 1)
+    b, pb = gen(depth + 1)
+    return f"{a}**{b}", f"({pa})**({pb})"
+
+
+bad = 0
+for _ in range(20000):
+    text, ptext = gen()
+    try:
+        expected = eval(ptext)  # noqa: S307 - test harness only
+    except (ZeroDivisionError, ValueError):
+        continue
+    if not isinstance(expected, int):
+        continue
+    try:
+        got = evaluate(text)
+    except Exception as exc:  # noqa: BLE001
+        print("RAISED", repr(text), repr(exc), "expected", expected)
+        bad += 1
+        if bad > 8:
+            break
+        continue
+    if got != expected:
+        print("MISMATCH", repr(text), got, "expected", expected)
+        bad += 1
+        if bad > 8:
+            break
+print("done, bad =", bad)
