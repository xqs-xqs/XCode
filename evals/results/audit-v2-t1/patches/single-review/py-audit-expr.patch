@@ -17,5 +17,40 @@ class TestEvaluate(unittest.TestCase):
         self.assertEqual(evaluate("-7 % 3"), 2)
 
 
+class TestExtra(unittest.TestCase):
+    def test_values(self):
+        cases = {
+            "1 + 2 * 3": 7,
+            "(1 + 2) * 3": 9,
+            "7 // 2": 3,
+            "-7 % 3": 2,
+            "-7 // 2": -4,
+            "7 % -3": -2,
+            "2**3**2": 512,
+            "-2**2": -4,
+            "(-2)**2": 4,
+            "-2 * 3**2": -18,
+            "2 * -3 ** 2": -18,
+            "10 - 3 - 2": 5,
+            "100 // 7 // 2": 7,
+            "  4  *  ( 2 + 1 )  ": 12,
+            "8 // 2 * 3": 12,
+            "1 - -2": 3,
+            "2 ** 0 ** 0": 2,
+        }
+        for text, expected in cases.items():
+            self.assertEqual(evaluate(text), expected, text)
+
+    def test_errors(self):
+        for text in ["", "   ", "1 2", "1/2", "1 / 2", "(1+2", "1+2)", "1 +", "+1",
+                     "1 + * 2", "2 * * 3", "2 / / 3", "()", "abc", "1\t+ 2", "2**-1",
+                     "2**(-1)", "-2**2**-1", "1\n+2", "1 = 2"]:
+            with self.assertRaises(ValueError, msg=text):
+                evaluate(text)
+        for text in ["1//0", "1 % 0", "-7 // 0"]:
+            with self.assertRaises(ZeroDivisionError, msg=text):
+                evaluate(text)
+
+
 if __name__ == "__main__":
     unittest.main()
