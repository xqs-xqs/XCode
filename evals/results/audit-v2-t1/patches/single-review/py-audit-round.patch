+
+def _increment(digits: list) -> list:
+    """Add one to a list of decimal digits (no leading zeros assumed)."""
+    index = len(digits) - 1
+    while index >= 0:
+        if digits[index] == "9":
+            digits[index] = "0"
+            index -= 1
+        else:
+            digits[index] = chr(ord(digits[index]) + 1)
+            return digits
+    return ["1"] + digits
 
 
