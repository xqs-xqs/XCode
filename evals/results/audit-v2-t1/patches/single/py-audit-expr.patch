@@ -0,0 +1,124 @@
+"""Temporary differential check of solution.evaluate against a reference."""
+
+import ast
+import random
+import sys
+
+import solution
+
+
+def ref(source):
+    tree = ast.parse(source, mode="eval")
+    return ev(tree)
+
+
+def ev(node):
+    if isinstance(node, ast.Expression):
+        return ev(node.body)
+    if isinstance(node, ast.Constant):
+        return node.value
+    if isinstance(node, ast.UnaryOp):
+        assert isinstance(node.op, ast.USub)
+        return -ev(node.operand)
+    if isinstance(node, ast.BinOp):
+        left, right = ev(node.left), ev(node.right)
+        op = node.op
+        if isinstance(op, ast.Add):
+            return left + right
+        if isinstance(op, ast.Sub):
+            return left - right
+        if isinstance(op, ast.Mult):
+            return left * right
+        if isinstance(op, ast.FloorDiv):
+            if right == 0:
+                raise ZeroDivisionError
+            return left // right
+        if isinstance(op, ast.Mod):
+            if right == 0:
+                raise ZeroDivisionError
+            return left % right
+        if isinstance(op, ast.Pow):
+            if right < 0:
+                raise ValueError
+            return left ** right
+    raise ValueError("unsupported")
+
+
+def gen(depth=0):
+    """Return a list of token strings for a random expression."""
+    r = random.random()
+    if depth >= 3 or r < 0.35:
+        return [str(random.randint(0, 5))]
+    if r < 0.45:
+        return ["-"] + gen(depth + 1)
+    if r < 0.55:
+        return ["("] + gen(depth + 1) + [")"]
+    op = random.choice(["+", "-", "*", "//", "%", "**"])
+    left = gen(depth + 1)
+    if op == "**":
+        exponent = gen(depth + 1)
+        while "**" in exponent or "//" in exponent or "%" in exponent:
+            exponent = gen(depth + 1)
+        return left + ["**"] + exponent
+    return left + [op] + gen(depth + 1)
+
+
+def render(tokens):
+    out = []
+    for tok in tokens:
+        if out and random.random() < 0.6:
+            out.append(" ")
+        out.append(tok)
+    return "".join(out)
+
+
+def outcome(fn, source):
+    try:
+        return ("ok", fn(source))
+    except ZeroDivisionError:
+        return ("zerodiv", None)
+    except ValueError:
+        return ("value", None)
+    except Exception as exc:  # pragma: no cover
+        return (type(exc).__name__, str(exc))
+
+
+random.seed(1234)
+mismatches = 0
+for _ in range(4000):
+    tokens = gen()
+    source = render(tokens)
+    expected = outcome(ref, source)
+    if expected == ("ok", None) or (expected[0] == "ok" and isinstance(expected[1], float)):
+        continue
+    if expected[0] == "ok" and abs(expected[1]) > 10 ** 12:
+        continue
+    actual = outcome(solution.evaluate, source)
+    if actual != expected:
+        mismatches += 1
+        print("MISMATCH", repr(source), "expected", expected, "actual", actual)
+        if mismatches > 10:
+            break
+print("fuzz mismatches:", mismatches)
+
+cases = [
+    ("", "value"), ("  ", "value"), ("1 2", "value"), ("1 / 2", "value"),
+    ("+1", "value"), ("1 + +2", "value"), ("(1", "value"), ("1)", "value"),
+    ("1 +", "value"), ("*1", "value"), ("1 // 0", "zerodiv"),
+    ("1 % 0", "zerodiv"), ("2 ** -1", "value"), ("2 ** (0-1)", "value"),
+    ("1\t+2", "value"), ("1\n", "value"), ("1 * * 2", "value"),
+    ("1 **\t2", "value"), ("()", "value"), ("-2 ** 2 ** 2", "ok"),
+    ("-7 % 3", "ok"), ("-7 // 3", "ok"), ("2 ** 3 ** 2", "ok"),
+    ("-2 ** 2", "ok"), ("2 ** -2 ** 2", "value"), ("--2", "ok"),
+    ("(-2) ** 2", "ok"), ("  7  ", "ok"), ("1 2 * 3", "value"),
+]
+bad = 0
+for source, kind in cases:
+    actual = outcome(solution.evaluate, source)[0]
+    if actual != kind:
+        bad += 1
+        print("CASE MISMATCH", repr(source), "expected", kind, "actual", actual)
+print("case mismatches:", bad)
+print("values:",
+      solution.evaluate("-7 % 3"), solution.evaluate("-7 // 3"),
+      solution.evaluate("-2**2"), solution.evaluate("2**3**2"))
