 """Exact half-even rounding of decimal strings."""
 
 import re
-from decimal import ROUND_HALF_UP, Decimal, localcontext
 
-_NUMBER = re.compile(r"[-+]?[0-9]+(?:\.[0-9]+)?")
+_NUMBER = re.compile(r"-?[0-9]+(?:\.[0-9]+)?")
+
+
+def _increment(digits: str) -> str:
+    """Return the string of decimal digits incremented by one."""
+    chars = list(digits)
+    index = len(chars) - 1
+    while index >= 0:
+        if chars[index] == "9":
+            chars[index] = "0"
+            index -= 1
+        else:
+            chars[index] = chr(ord(chars[index]) + 1)
+            return "".join(chars)
+    return "1" + "".join(chars)
 
 
 def round_decimal(text: str, places: int) -> str:
+    if isinstance(places, bool) or not isinstance(places, int):
+        raise TypeError("places must be an integer")
     if places < 0:
         raise ValueError("places must not be negative")
     if not isinstance(text, str) or _NUMBER.fullmatch(text) is None:
         raise ValueError(f"malformed number {text!r}")
-    with localcontext() as context:
-        value = Decimal(text).quantize(Decimal(1).scaleb(-places), rounding=ROUND_HALF_UP)
-    rendered = format(value, "f")
-    return rendered
+
+    negative = text.startswith("-")
+    body = text[1:] if negative else text
+    integer_part, _, fraction_part = body.partition(".")
+
+    int_digits = integer_part
+    frac_digits = fraction_part
+
+    if places >= len(fraction_part):
+        # Nothing is discarded here, so only zero padding is required.
+        frac_digits = fraction_part + "0" * (places - len(fraction_part))
+    else:
+        digits = integer_part + fraction_part
+        kept_end = len(integer_part) + places
+        frac_digits = digits[len(integer_part):kept_end]
+        discarded = digits[kept_end:]
+        if discarded[0] > "5":
+            round_up = True
+        elif discarded[0] < "5":
+            round_up = False
+        else:
+            # Exactly half (or more): round half to even.
+            round_up = discarded[1:].strip("0") != "" or digits[kept_end - 1] in "13579"
+        if round_up:
+            combined = _increment(int_digits + frac_digits)
+            if places == 0:
+                int_digits, frac_digits = combined, ""
+            else:
+                int_digits, frac_digits = combined[:-places], combined[-places:]
+
+    int_digits = int_digits.lstrip("0") or "0"
+    is_zero = int_digits == "0" and frac_digits.strip("0") == ""
+    sign = "-" if negative and not is_zero else ""
+    if places == 0:
+        return sign + int_digits
+    return sign + int_digits + "." + frac_digits
