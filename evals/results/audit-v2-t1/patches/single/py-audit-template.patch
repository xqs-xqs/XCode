diff --git a/test_extra.py b/test_extra.py
new file mode 100644
index 0000000000000000000000000000000000000000..0ad25e506be58f392ef709da5ddfbcac44de3ffa
--- /dev/null
+++ b/test_extra.py
@@ -0,0 +1,48 @@
+import unittest
+
+from solution import render
+
+
+class TestSpec(unittest.TestCase):
+    def test_cases(self):
+        cases = [
+            ("{ name | upper }", {"name": " a "}, " A "),
+            ("{v|trim|upper}", {"v": " ab "}, "AB"),
+            ("{a.b}", {"a": {"b": 2}}, "2"),
+            ("{{}}", {}, "{}"),
+            ("{{x}}", {}, "{x}"),
+            ("{v|title}", {"v": "ab cd"}, "Ab Cd"),
+            ("{v|upper|lower}", {"v": "Ab"}, "ab"),
+            ("{ v }", {"v": 1}, "1"),
+            ("a}}b", {}, "a}b"),
+        ]
+        for t, v, e in cases:
+            self.assertEqual(render(t, v), e, t)
+
+    def test_errors(self):
+        value_errors = [
+            ("{}", {}),
+            ("{ }", {}),
+            ("{a|}", {"a": 1}),
+            ("{a|  }", {"a": 1}),
+            ("{a|nope}", {"a": 1}),
+            ("{a.}", {}),
+            ("{a..b}", {"a": {}}),
+            ("{a", {}),
+            ("}", {}),
+        ]
+        for t, v in value_errors:
+            with self.assertRaises(ValueError, msg=t):
+                render(t, v)
+        key_errors = [
+            ("{a.b}", {"a": 5}),
+            ("{x}", {}),
+            ("{a.b}", {"a": {}}),
+        ]
+        for t, v in key_errors:
+            with self.assertRaises(KeyError, msg=t):
+                render(t, v)
+
+
+if __name__ == "__main__":
+    unittest.main()
