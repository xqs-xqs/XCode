--- /dev/null
+++ b/check_spec.py
@@ -0,0 +1,43 @@
+from solution import render as r
+
+cases = [
+    ("{ name | upper }", {"name": " a "}, "A"),
+    ("{v|trim|upper}", {"v": " ab "}, "AB"),
+    ("{a.b}", {"a": {"b": 2}}, "2"),
+    ("{{}}", {}, "{}"),
+    ("{{x}}", {}, "{x}"),
+    ("{v|title}", {"v": "ab cd"}, "Ab Cd"),
+    ("{v|upper|lower}", {"v": "Ab"}, "ab"),
+    ("{ v }", {"v": 1}, "1"),
+    ("a}}b", {}, "a}b"),
+]
+for t, v, e in cases:
+    got = r(t, v)
+    assert got == e, (t, got, e)
+
+for t, v in [
+    ("{}", {}),
+    ("{ }", {}),
+    ("{a|}", {"a": 1}),
+    ("{a|  }", {"a": 1}),
+    ("{a|nope}", {"a": 1}),
+    ("{1a}", {}),
+    ("{a.}", {}),
+    ("{a..b}", {"a": {}}),
+    ("{a", {}),
+    ("}", {}),
+    ("{a.b}", {"a": 5}),
+    ("{x}", {}),
+    ("{a.b}", {"a": {}}),
+]:
+    try:
+        r(t, v)
+    except KeyError as ex:
+        print(t, "KeyError")
+        continue
+    except ValueError as ex:
+        print(t, "ValueError")
+        continue
+    raise AssertionError("no raise " + t)
+
+print("all ok")
