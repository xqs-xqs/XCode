 import heapq
 
 
+def _can_reach_self(start: str, graph: dict) -> bool:
+    """True if ``start`` is part of a cycle in ``graph``."""
+    seen = set()
+    stack = list(graph[start])
+    while stack:
+        node = stack.pop()
+        if node == start:
+            return True
+        if node in seen:
+            continue
+        seen.add(node)
+        stack.extend(graph[node])
+    return False
+
+
+def _shortest_cycle(start: str, graph: dict) -> list:
+    """Shortest dependency cycle through ``start``, alphabetically minimal."""
+    paths = {start: [start]}
+    frontier = [start]
+    while frontier:
+        found = []
+        longer = {}
+        for node in frontier:
+            path = paths[node]
+            for need in graph[node]:
+                if need == start:
+                    found.append(path + [start])
+                elif need not in paths:
+                    candidate = path + [need]
+                    best = longer.get(need)
+                    if best is None or candidate < best:
+                        longer[need] = candidate
+        if found:
+            return min(found)
+        paths.update(longer)
+        frontier = list(longer)
+    return []
+
+
+def _cycle_message(dependencies: dict, done: set) -> str:
+    graph = {
+        name: sorted(need for need in needs if need not in done)
+        for name, needs in dependencies.items()
+        if name not in done
+    }
+    start = min(name for name in graph if _can_reach_self(name, graph))
+    return " -> ".join(_shortest_cycle(start, graph))
+
