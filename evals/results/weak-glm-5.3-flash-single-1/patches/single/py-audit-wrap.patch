@@ -0,0 +1,43 @@
+import unittest
+
+from solution import wrap
+
+
+class SpecChecks(unittest.TestCase):
+    def test_paragraph_separators(self):
+        self.assertEqual(wrap("aa bb\n\n\ncc", 5), ["aa bb", "", "cc"])
+        self.assertEqual(wrap("aa\n  \n\t\nbb", 5), ["aa", "", "bb"])  # ws-only line is blank
+        self.assertEqual(wrap("aa\n\n\n\nbb", 5), ["aa", "", "bb"])
+        self.assertEqual(wrap("aa\nbb", 5), ["aa bb"])  # single newline separates words
+        self.assertEqual(wrap("aa\n\n\nbb\n\n\ncc", 5), ["aa", "", "bb", "", "cc"])
+
+    def test_no_words(self):
+        self.assertEqual(wrap("", 3), [])
+        self.assertEqual(wrap(" \n\t ", 3), [])
+        self.assertEqual(wrap("a\n\n", 5), ["a"])  # no trailing ""
+
+    def test_value_error(self):
+        for w in (0, -1, -9):
+            with self.assertRaises(ValueError):
+                wrap("x", w)
+
+    def test_long_words(self):
+        self.assertEqual(wrap("abcdef", 3), ["abc", "def"])
+        self.assertEqual(wrap("abcdefg", 3), ["abc", "def", "g"])
+        self.assertEqual(wrap("hi abcdefg jk", 3), ["hi", "abc", "def", "g", "jk"])  # 4 chars > 3
+        self.assertEqual(wrap("hi abcdefgh z", 3), ["hi", "abc", "def", "gh", "z"])  # 2+1+1=4 > 3
+        self.assertEqual(wrap("abcde f", 4), ["abcd", "e f"])  # joins 1-char last chunk
+        self.assertEqual(wrap("hi abcdefg mn", 3), ["hi", "abc", "def", "g", "mn"])
+        self.assertEqual(wrap("ab abcdef xy", 4), ["ab", "abcd", "ef", "xy"])
+        self.assertEqual(wrap("aaaaaa\n\nbb", 3), ["aaa", "aaa", "", "bb"])
+
+    def test_fill_and_whitespace(self):
+        self.assertEqual(wrap("a bb ccc dddd", 6), ["a bb", "ccc", "dddd"])
+        self.assertEqual(wrap("one two three", 7), ["one two", "three"])
+        self.assertEqual(wrap("x  y\tz\n w", 4), ["x y", "z w"])
+        for l in wrap("  a  b ", 1):
+            self.assertEqual(l, l.strip())
+
+
+if __name__ == "__main__":
+    unittest.main()
