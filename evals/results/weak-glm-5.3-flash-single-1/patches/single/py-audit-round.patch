+    negative = match.group(1) is not None
+    int_part = match.group(2)
+    frac_part = match.group(3) or ""
+
+    # Magnitude digits, split from the right into the integer part and
+    # exactly `places` fraction digits. All arithmetic is done on decimal
+    # digit strings, so no binary floating point is involved and inputs of
+    # any length are handled exactly.
+    if places >= len(frac_part):
+        digits = int_part + frac_part + "0" * (places - len(frac_part))
+    else:
+        digits = int_part + frac_part[:places]
+        dropped = frac_part[places]
+        rest = frac_part[places + 1:]
+        if dropped > "5" or (dropped == "5" and any(c != "0" for c in rest)):
+            digits = _add_one(digits)
+        elif dropped == "5" and digits[-1] in "13579":
+            # Exact halfway case: round towards the even neighbour.
+            digits = _add_one(digits)
+
+    if places:
+        int_digits = digits[:-places]
+        frac_digits = digits[-places:]
+    else:
+        int_digits = digits
+        frac_digits = ""
+
+    int_digits = int_digits.lstrip("0") or "0"
