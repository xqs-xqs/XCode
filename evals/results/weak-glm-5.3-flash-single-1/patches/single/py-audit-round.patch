 """Exact half-even rounding of decimal strings."""
 
 import re
-from decimal import ROUND_HALF_UP, Decimal, localcontext
 
-_NUMBER = re.compile(r"[-+]?[0-9]+(?:\.[0-9]+)?")
+_NUMBER = re.compile(r"(-)?([0-9]+)(?:\.([0-9]+))?")
+
+
+def _add_one(digits: str) -> str:
+    """Increment a plain digit string by one, growing it on carry."""
+    out = list(digits)
+    i = len(out) - 1
+    while i >= 0:
+        if out[i] == "9":
+            out[i] = "0"
+            i -= 1
+        else:
+            out[i] = chr(ord(out[i]) + 1)
+            break
+    else:
+        out.insert(0, "1")
+    return "".join(out)
 
 
 def round_decimal(text: str, places: int) -> str:
     if places < 0:
         raise ValueError("places must not be negative")
