index 0000000000000000000000000000000000000000..0b2fd593c39afcf0729f17b514c13f89010ed698
--- /dev/null
+++ b/test_solution.py
@@ -0,0 +1,67 @@
+import unittest
+
+from solution import compress, expand
+
+
+class CompressTests(unittest.TestCase):
+    def test_reported_case(self):
+        self.assertEqual(compress([1, 2, 4, 5, 6]), "1,2,4-6")
+
+    def test_dedup(self):
+        self.assertEqual(compress([1, 1, 2, 2, 2, 5]), "1-2,5")
+        self.assertEqual(compress([7, 7, 7]), "7")
+
+    def test_runs_of_two_stay_single(self):
+        self.assertEqual(compress([1, 2, 4]), "1,2,4")
+        self.assertEqual(compress([1, 2]), "1,2")
+
+    def test_iterable_input(self):
+        self.assertEqual(compress(iter([1, 2, 4, 5, 6])), "1,2,4-6")
+        self.assertEqual(compress(x for x in [3, 3, 4]), "3-4")
+
+    def test_unsorted_input(self):
+        self.assertEqual(compress([6, 4, 5, 1, 2]), "1,2,4-6")
+
+    def test_negatives(self):
+        self.assertEqual(compress([-3, -2, -1]), "-3--1")
+        self.assertEqual(compress([-2, -1, 1, 2]), "-2--1,1-2")
+        self.assertEqual(compress([-1, 0, 1]), "-1-1")
+
+    def test_empty_and_single(self):
+        self.assertEqual(compress([]), "")
+        self.assertEqual(compress([5]), "5")
+        self.assertEqual(compress([1, 3, 5]), "1,3,5")
+
+
+class ExpandTests(unittest.TestCase):
+    def test_roundtrip(self):
+        self.assertEqual(expand(compress([-3, -2, -1, 1, 2, 4, 5, 6])), [-3, -2, -1, 1, 2, 4, 5, 6])
+
+    def test_whitespace(self):
+        self.assertEqual(expand(""), [])
+        self.assertEqual(expand("   "), [])
+        self.assertEqual(expand(" 1, 2 , 4 - 6 "), [1, 2, 4, 5, 6])
+        self.assertEqual(expand("1 - 3"), [1, 2, 3])
+
+    def test_lenient_ranges(self):
+        self.assertEqual(expand("4-4"), [4])
+        self.assertEqual(expand("1-2"), [1, 2])
+        self.assertEqual(expand("3-5,1-2"), [1, 2, 3, 4, 5])
+        self.assertEqual(expand("1-3,2"), [1, 2, 3])
+        self.assertEqual(expand("2,1"), [1, 2])
+
+    def test_negative_ranges(self):
+        self.assertEqual(expand("-3--1"), [-3, -2, -1])
+        self.assertEqual(expand(" -3 -- 1 "), [-3, -2, -1])
+        self.assertEqual(expand("-1-1"), [-1, 0, 1])
+
+    def test_errors(self):
+        for bad in ["5-3", "1,,2", ",1", "1,", "x", "1-2-3", "1.5", "1-", "-x",
+                    "1 - -2", "+1", "1e2", ",", "1--", "--1", "1-2 ", " 1 2"]:
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
+                    expand(bad)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
