@@ -0,0 +1,92 @@
+import unittest
+
+from solution import allocate
+
+
+class ExtraSpecChecks(unittest.TestCase):
+    def test_values(self):
+        cases = [
+            (100, [1, 1, 1], [34, 33, 33]),
+            (100, [2, 1, 1], [50, 25, 25]),
+            (101, [1, 1], [51, 50]),
+            (100, [1, 0, 3], [25, 0, 75]),
+            (0, [1, 1], [0, 0]),
+            (-100, [1, 1, 1], [-34, -33, -33]),
+            (-7, [1, 2], [-2, -5]),
+            (-1, [1, 1], [-1, 0]),
+            (10**40 + 1, [1, 1, 1], [(10**40 - 1) // 3 + 1, (10**40 - 1) // 3 + 1, (10**40 - 1) // 3]),
+            (10**60, [7, 3], [7 * 10**59, 3 * 10**59]),
+        ]
+        for total, weights, want in cases:
+            self.assertEqual(allocate(total, weights), want, (total, weights))
+
+    def test_errors(self):
+        for func, expected in [
+            (lambda: allocate(100, []), ValueError),
+            (lambda: allocate(100, [0, 0]), ValueError),
+            (lambda: allocate(100, [-1, 2]), ValueError),
+            (lambda: allocate(100.0, [1]), TypeError),
+            (lambda: allocate(100, ["1"]), TypeError),
+            (lambda: allocate(True, [1]), TypeError),
+            (lambda: allocate(100, [True, 1]), TypeError),
+            (lambda: allocate(100, [False, 0]), TypeError),
+            (lambda: allocate(100, [1, None]), TypeError),
+        ]:
+            with self.assertRaises(expected):
+                func()
+
+    def test_properties(self):
+        import random
+
+        rng = random.Random(1234)
+        for _ in range(2000):
+            n = rng.randint(1, 8)
+            weights = [rng.randint(0, 10) for _ in range(n)]
+            if not any(weights):
+                weights[rng.randrange(n)] = 1
+            total = rng.choice(
+                [rng.randint(-10**6, 10**6), rng.randint(-1, 1), rng.randint(-10**80, 10**80)]
+            )
+            parts = allocate(total, weights)
+            self.assertEqual(sum(parts), total)
+            self.assertEqual(len(parts), n)
+            for p, w in zip(parts, weights):
+                if w == 0:
+                    self.assertEqual(p, 0)
+            if total < 0:
+                self.assertEqual(parts, [-p for p in allocate(-total, weights)])
+            if total != 0:
+                # |part| is floor or floor+1 of its exact proportional share
+                scale = sum(weights)
+                for p, w in zip(parts, weights):
+                    fl, _rem = divmod(abs(total) * w, scale)
+                    self.assertTrue(fl <= abs(p) <= fl + 1)
+
+
+    def test_exhaustive_small_domain(self):
+        import itertools
+
+        def reference(total, weights):
+            scale = sum(weights)
+            mag = abs(total)
+            base = [mag * w // scale for w in weights]
+            rem = [mag * w % scale for w in weights]
+            leftover = mag - sum(base)
+            extras = sorted(range(len(weights)), key=lambda i: (-rem[i], i))[:leftover]
+            parts = [b + (1 if i in extras else 0) for i, b in enumerate(base)]
+            return [-p for p in parts] if total < 0 else parts
+
+        for n in range(1, 5):
+            for weights in itertools.product(range(4), repeat=n):
+                if not any(weights):
+                    continue
+                for total in range(-40, 41):
+                    self.assertEqual(
+                        allocate(total, list(weights)),
+                        reference(total, list(weights)),
+                        (total, weights),
+                    )
+
+
+if __name__ == "__main__":
+    unittest.main()
