diff --git a/test_matrix.py b/test_matrix.py
new file mode 100644
index 0000000000000000000000000000000000000000..d00a7c2462246debf988a0d8c4f7b52cbea393a1
--- /dev/null
+++ b/test_matrix.py
@@ -0,0 +1,65 @@
+import unittest
+
+import solution
+
+
+class TestSpecMatrix(unittest.TestCase):
+    def check(self, text, expected):
+        self.assertEqual(solution.evaluate(text), expected)
+
+    def raises(self, text, exc):
+        with self.assertRaises(exc):
+            solution.evaluate(text)
+
+    def test_values(self):
+        self.check("1 + 2 * 3", 7)
+        self.check("(1 + 2) * 3", 9)
+        self.check("2 ** 3 ** 2", 512)          # ** right-assoc
+        self.check("-2 ** 2", -4)               # unary binds looser than **
+        self.check("-7 % 3", 2)                 # reported bug
+        self.check("7 % -3", -2)
+        self.check("-7 % -3", -1)               # Python floor semantics
+        self.check("-7 // 2", -4)
+        self.check("7 // -2", -4)
+        self.check("-7 // -2", 3)
+        self.check("-2 * -3", 6)
+        self.check("2 - -3", 5)
+        self.check("  12   +  3  ", 15)
+        self.check("2**3%5", 3)
+        self.check("0 ** 0", 1)
+        self.check("-0", 0)
+        self.check("2 - 3 - 4", -5)             # left-assoc
+        self.check("20 // 3 % 4", 2)
+        self.check("1 - 2 * 3 ** 2 // 4 % 5", -3)
+        self.check("((2))", 2)
+        self.check("-(-2)", 2)
+        self.check("2 ** (1 + 1)", 4)
+        self.check("10 ** 2", 100)
+
+    def test_errors(self):
+        self.raises("2 ** -2", ValueError)      # negative exponent
+        self.raises("-2 ** -2", ValueError)
+        self.raises("1 // 0", ZeroDivisionError)
+        self.raises("1 % 0", ZeroDivisionError)
+        for bad in [
+            "", "   ",          # empty input
+            "1 +", "+1", "*3", "3 *",           # missing operand
+            "1 / 2", "/",                       # single slash
+            "1 2",                              # two numbers in a row
+            "(1 + 2", "1 + 2)", "()",           # unbalanced parens
+            "abc", "1 & 2", "1..2", "1e3",      # unknown chars
+            "3 ** * 2",                         # missing operand
+        ]:
+            self.raises(bad, ValueError)
+
+    def test_unary_minus_chain(self):
+        self.check("- - 3", 3)
+        self.check("1 - -1", 2)
+
+    def test_big_numbers(self):
+        big = int("9" * 400) * (10 ** 5)
+        self.check("9" * 400 + "*" + str(10 ** 5), big)
+
+
+if __name__ == "__main__":
+    unittest.main()
