 """Exact half-even rounding of decimal strings."""
 
 import re
-from decimal import ROUND_HALF_UP, Decimal, localcontext
 
-_NUMBER = re.compile(r"[-+]?[0-9]+(?:\.[0-9]+)?")
+# Optional minus, at least one integer digit, optional point plus at least one
+# fraction digit.  No plus sign, no exponent, no separators, no whitespace.
+_NUMBER = re.compile(r"-?[0-9]+(?:\.[0-9]+)?")
+
+
+def _increment(digits: str) -> str:
+    """Add one to a string of decimal digits (no leading-zero guarantees)."""
+    result = list(digits)
+    position = len(result) - 1
+    while position >= 0:
+        if result[position] != "9":
+            result[position] = chr(ord(result[position]) + 1)
+            return "".join(result)
+        result[position] = "0"
+        position -= 1
+    return "1" + "".join(result)
 
 
